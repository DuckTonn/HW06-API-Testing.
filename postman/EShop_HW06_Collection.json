          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pham Duc Toan\",\n  \"email\": \"autouser_{{$randomInt}}_{{$timestamp}}@test.com\",\n  \"password\": \"Password123!\"\n}"
